{
  "name": "docs-web",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/generate-sitemap.mjs",
    "start": "serve .output/public --config ../../serve.json",
    "preview": "vite preview",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "generate-api-docs": "cargo run --manifest-path ../backend/app/Cargo.toml --bin herald-app -- --export-openapi ./openapi.json"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@tanstack/react-router": "1.170.8",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.14",
    "@tanstack/start-static-server-functions": "1.167.9",
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.10",
    "fumadocs-openapi": "^10.9.1",
    "fumadocs-ui": "16.9.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^8.0.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/vite": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "nitro": "3.0.260522-beta",
    "serve": "^14.2.6",
    "srvx": "^0.11.16",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
